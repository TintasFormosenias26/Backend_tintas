datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

// Definir el enum Role
enum Role {
  USER
  ADMIN
  MODERATOR
}

model User {
  id          String   @id @default(cuid())

  name        String
  lastName    String
  userName    String   @unique
  birthDate   DateTime
  email       String   @unique
  password    String

  nivel       String?
  imgLevel    String?

  rol         Role     @default(USER)
  point       Int      @default(0)

  avatarId    String
  avatar      Avatar   @relation(fields: [avatarId], references: [id])?

  preference  Preference?

  progresses  BookProgress[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Preference {
  id         String @id @default(cuid())
  userId     String @unique

  categories String[]
  formats    String[]

  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Modelo BookProgress (relación opcional)
model BookProgress {
  id        String   @id @default(cuid())
  userId    String
  bookId    String
  progress  Int      @default(0)
  status    ProgressStatus @default(PLANNED)
  startedAt DateTime?
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, bookId])
}

// Enum para el estado del progreso
enum ProgressStatus {
  PLANNED
  READING
  COMPLETED
  DROPPED
  ON_HOLD
}
//Authors 
model Author {
  id            String   @id @default(cuid())
  fullName      String
  biography     String
  profession    String
  birthdate     DateTime
  birthplace    String
  nationality   String
  itActivo      Boolean

  writingGenre  String[]

  avatarIdImage String
  avatarUrl     String

  books         Book[]
}

//Books
model Book {
  id                String   @id @default(cuid())

  title             String
  summary           String
  synopsis          String

  language          String
  available         Boolean  @default(true)

  yearBook          String

  genre             String
  level             String

  format            String
  fileExtension     String

  totalPages        Int?
  duration          Int?

  anthology         Boolean @default(false)

  contentBookId     String
  contentBookUrl    String

  coverImageId      String
  coverImageUrl     String

  theme             String[]
  subgenre          String[]

  authors           Author[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Avatar {
  id         String   @id @default(cuid())

  idImage    String
  urlSecura  String

  gender     String
  users User[]?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}