datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

// Definir el enum Role
enum Role {
  USER
  ADMIN
  MODERATOR
}

model User {
  id          String   @id @default(cuid())

  name        String
  lastName    String
  userName    String   @unique
  birthDate   DateTime
  email       String   @unique
  password    String

  nivel       String?
  imgLevel    String?
  level       Level

  rol         Role     @default(USER)
  point       Int      @default(0)

  avatar  String     

  preference  Preference?

  progresses  BookProgress[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Preference {
  id         String @id @default(cuid())
  userId     String @unique

  categories String[]
  formats    String[]

  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Modelo BookProgress (relación opcional)
enum ProgressUnit {
  PAGE
  PAGES
  SECOND
  SECONDS
}

enum ProgressStatus {
  READING
  FINISHED
  PENDING
}

model BookProgress {
  id          String           @id @default(cuid())

  userId      String
  bookId      String

  unit        ProgressUnit
  position    Int
  percent     Float
  total       Int

  status      ProgressStatus   @default(READING)

  startDate   DateTime
  finishDate  DateTime?

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  book        Book             @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@map("book_progress")
}
//BookContent

model BookContent {
  id      String @id @default(uuid())

  page    Int
  content String

  bookId  String
  book    Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
}

//Authors 
model Author {
  id            String   @id @default(cuid())
  fullName      String
  biography     String
  profession    String
  birthdate     DateTime
  birthplace    String
  nationality   String
  isActivo      Boolean

  photoIdImage String
  photoUrl     String

  books         Book[]
}
//level
enum Level {
  INICIAL
  SECUNDARIO
  JOVEN_ADULTO
  ADULTO_MAYOR
}

//Books
model Book {
  id                String   @id @default(cuid())

  title             String
  summary           String
  synopsis          String

  language          String
  available         Boolean  @default(true)

  yearBook          String

  genre             String
  level             Level

  format            String
  fileExtension     String

  totalPages        Int?
  duration          Int?

  anthology         Boolean @default(false)

  contentBookId     String
  contentBookUrl    String
  

  coverImageId      String
  coverImageUrl     String

  theme             String[]
  subgenre          String[]

  authors           Author[]
  contents BookContent[]
  progresses BookProgress[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Avatar {
  id         String   @id @default(cuid())

  idImage    String
  urlSecura  String

  gender     String

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}